{
    "name": "simplecms/wechat",
    "description": "微信小程序",
    "keywords": [
        "laravel",
        "wechat",
        "simplecms"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SimpleCMS\\Wechat\\": "src/"
        }
    },
    "authors": [
        {
            "name": "hackout",
            "email": "hackout@vip.qq.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/config": "^12.0",
        "illuminate/routing": "^12.0",
        "w7corp/easywechat": "^6.7"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimpleCMS\\Wechat\\WechatServiceProvider"
            ],
            "aliases": {
                "MiniProgram": "SimpleCMS\\Wechat\\Facades\\MiniProgram"
            }
        }
    }
}